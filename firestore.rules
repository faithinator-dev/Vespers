rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Hardened Primitives ---
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateKey(dateKey) {
      return dateKey is string && dateKey.size() == 10 && dateKey.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidMoodValue(mood) {
      return mood is string
        && mood.size() <= 24
        && mood in ['serene', 'reflective', 'inspired', 'melancholy', 'restless'];
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'preferredLampWarmth', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'preferredLampWarmth', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == userId
        && isValidId(data.uid)
        && data.displayName is string
        && data.displayName.size() <= 120
        && data.email is string
        && data.email.size() <= 254
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000))
        && data.preferredLampWarmth is number
        && data.preferredLampWarmth >= 0.2
        && data.preferredLampWarmth <= 1.8
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidJournalEntry(data, userId, entryId) {
      return data.keys().hasAll([
          'id',
          'userId',
          'dateKey',
          'title',
          'contentHtml',
          'plainText',
          'wordCount',
          'mood',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'dateKey',
          'title',
          'contentHtml',
          'plainText',
          'wordCount',
          'mood',
          'promptUsed',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string
        && data.id == entryId
        && isValidId(data.id)
        && data.userId is string
        && data.userId == userId
        && isValidId(data.userId)
        && isValidDateKey(data.dateKey)
        && data.title is string
        && data.title.size() <= 200
        && data.contentHtml is string
        && data.contentHtml.size() <= 60000
        && data.plainText is string
        && data.plainText.size() <= 40000
        && data.wordCount is int
        && data.wordCount >= 0
        && data.wordCount <= 20000
        && isValidMoodValue(data.mood)
        && (!('promptUsed' in data) || (data.promptUsed is string && data.promptUsed.size() <= 300))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMoodLog(data, userId, dateKey) {
      return data.keys().hasAll(['userId', 'dateKey', 'mood', 'note', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'dateKey', 'mood', 'note', 'createdAt', 'updatedAt'])
        && data.userId is string
        && data.userId == userId
        && isValidId(data.userId)
        && data.dateKey is string
        && data.dateKey == dateKey
        && isValidDateKey(data.dateKey)
        && isValidMoodValue(data.mood)
        && data.note is string
        && data.note.size() <= 400
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'preferredLampWarmth', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['preferredLampWarmth', 'updatedAt'])
        );
      allow delete: if false;

      match /entries/{entryId} {
        allow get: if isValidId(userId) && isValidId(entryId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(entryId)
          && isValidJournalEntry(incoming(), userId, entryId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(entryId)
          && isValidJournalEntry(incoming(), userId, entryId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'dateKey',
            'title',
            'contentHtml',
            'plainText',
            'wordCount',
            'mood',
            'promptUsed',
            'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(entryId) && isOwner(userId);
      }

      match /moodLogs/{dateKey} {
        allow get: if isValidId(userId) && isValidDateKey(dateKey) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidDateKey(dateKey)
          && isValidMoodLog(incoming(), userId, dateKey)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidDateKey(dateKey)
          && isValidMoodLog(incoming(), userId, dateKey)
          && incoming().userId == existing().userId
          && incoming().dateKey == existing().dateKey
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['mood', 'note', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidDateKey(dateKey) && isOwner(userId);
      }
    }
  }
}
